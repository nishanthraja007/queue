# ================================================================
# HAMS — Environment Configuration
# Copy this to .env and fill in your actual credentials
# ================================================================

# --------------- Twilio SMS Credentials ---------------
# Sign up free at: https://www.twilio.com/try-twilio
# These values come from: https://console.twilio.com/

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# --------------- SMS Feature Flags ---------------------
SMS_ENABLED=true
SMS_TOP_N_THRESHOLD=10        # Send SMS when patient enters top N of queue
SMS_POLL_INTERVAL_SECONDS=30  # How often background monitor checks queues

# --------------- JWT Secret ----------------------------
JWT_SECRET_KEY=dev-only-secret-change-me

# --------------- Database URL --------------------------
# Default: SQLite (zero-config for demo)
# Production: postgresql://user:password@localhost:5432/hams
DATABASE_URL=sqlite:///./hams.db
